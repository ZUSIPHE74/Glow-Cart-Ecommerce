# Local development. Copy to main_project/.env (never commit .env).
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=only-needed-when-DEBUG-is-False

# Leave unset to use a local SQLite file, or point at Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PayFast: the defaults are PayFast's public sandbox merchant (no real money).
PAYFAST_SANDBOX=True
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=

# Seller details shown on the contact, terms and privacy pages.
# SELLER_NAME=
# SELLER_EMAIL=
